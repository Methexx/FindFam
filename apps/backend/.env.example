# Supabase pooled connection string (Connection Pooling tab, Transaction
# mode, port 6543) — used by the running app.
DATABASE_URL=
# Supabase direct connection string (Connection string tab, "URI") — used
# only by node-pg-migrate. Pooled connections can break migration tooling's
# DDL/prepared-statement behavior, so this must stay separate from
# DATABASE_URL above.
DATABASE_MIGRATIONS_URL=
# Upstash Redis TCP connection string (rediss://...), not the REST URL/token
# — this backend's ioredis client speaks the TCP protocol.
REDIS_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
NODE_ENV=development
PORT=3000
