# Local Docker Postgres — day-to-day dev talks to this, not Supabase.
# `docker compose -f infra/docker-compose.yml up -d` starts it.
DATABASE_URL=postgres://findfam:findfam@localhost:5432/findfam
# Supabase direct connection string (Connection string tab, "URI") — used
# only by node-pg-migrate (npm run migrate:up), for occasional migrations
# against the deployed database. Not needed for day-to-day local dev; leave
# blank unless you're actually running a migration against Supabase.
DATABASE_MIGRATIONS_URL=
# Local Docker Redis — day-to-day dev talks to this, not Upstash.
REDIS_URL=redis://localhost:6379
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed to call the API (admin-web).
# Defaults to admin-web's local dev port if unset.
ALLOWED_ORIGINS=http://localhost:3001
