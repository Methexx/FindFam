{
  "name": "@findfam/backend",
  "version": "0.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "migrate:dev:up": "node --env-file=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:dev:down": "node --env-file=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "migrate:up": "node --env-file=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -d DATABASE_MIGRATIONS_URL -s public -s extensions",
    "migrate:down": "node --env-file=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js down -d DATABASE_MIGRATIONS_URL -s public -s extensions",
    "migrate:test:up": "node --env-file=.env.test ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:test:down": "node --env-file=.env.test ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "seed:admin": "node --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/seed-admin.ts"
  },
  "dependencies": {
    "@findfam/shared-types": "*",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.10.0",
    "fastify": "^4.28.0",
    "fastify-plugin": "^4.5.0",
    "ioredis": "^5.4.0",
    "jose": "^5.6.0",
    "kysely": "^0.27.0",
    "pg": "^8.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@findfam/config": "*",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "node-pg-migrate": "^7.6.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
